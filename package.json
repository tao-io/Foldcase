{
  "name": "foldcase",
  "version": "0.1.0",
  "description": "The typed, deterministic test loop for Foldkit Showcases. `foldcase test` boots each Showcase headlessly and asserts on the Model, `foldcase docs` tables its Model/Message schemas, and `foldcase mcp` serves the catalog to an agent.",
  "keywords": [
    "foldkit",
    "effect",
    "bun",
    "showcase",
    "component-testing",
    "mcp",
    "tea",
    "elm-architecture"
  ],
  "homepage": "https://github.com/tao-io/foldcase",
  "bugs": {
    "url": "https://github.com/tao-io/foldcase/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tao-io/foldcase.git"
  },
  "license": "MIT",
  "author": "tao-io",
  "contributors": [
    "Aiden Bai (Openstory — the fork this line descends from; see NOTICE)"
  ],
  "type": "module",
  "bin": {
    "foldcase": "./dist/main.js",
    "foldcase-bun": "./dist/main.bun.js"
  },
  "exports": {
    ".": {
      "types": "./dist/runner.d.ts",
      "import": "./dist/runner.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js"
    },
    "./mcp/catalog": {
      "types": "./dist/mcp/catalog.d.ts",
      "import": "./dist/mcp/catalog.js"
    },
    "./mcp/tools": {
      "types": "./dist/mcp/tools.d.ts",
      "import": "./dist/mcp/tools.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "prepack": "mise run build"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18.0",
    "bun": ">=1.3.14"
  },
  "peerDependencies": {
    "@effect/platform-bun": ">=4.0.0-beta.90",
    "@effect/platform-node": ">=4.0.0-beta.90",
    "effect": ">=4.0.0-beta.90"
  },
  "peerDependenciesMeta": {
    "@effect/platform-bun": {
      "optional": true
    },
    "@effect/platform-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.2",
    "@effect/platform-bun": "4.0.0-beta.102",
    "@effect/platform-node": "4.0.0-beta.102",
    "@types/bun": "latest",
    "effect": "4.0.0-beta.102",
    "oxlint": "1.71.0",
    "typescript": "^6.0.3"
  }
}
