# Dependencies
node_modules/

# Build output
dist/
/foldcase
*.tgz
*.tsbuildinfo

# Generated output
/foldcase-docs/
# Anchored: `src/coverage/` is the `--coverage` implementation, not a report.
# Unanchored, this pattern hid every new file in that directory from `git add`.
/coverage/

# Local / editor
.DS_Store
.env
.claude/
.cursor/

# Artifacts left behind by the pre-`core` fork toolchain (see the `foldkit`
