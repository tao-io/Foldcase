{
  "name": "openstory",
  "version": "0.0.16",
  "description": "A lightweight, Vite-native CSF 3 alternative to Storybook. Agent-first component lab.",
  "keywords": [
    "components",
    "csf",
    "react",
    "solid",
    "stories",
    "storybook",
    "ui",
    "vite"
  ],
  "homepage": "https://openstory.dev",
  "bugs": {
    "url": "https://github.com/millionco/openstory/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Aiden Bai",
    "email": "aiden@million.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/millionco/openstory.git"
  },
  "bin": {
    "openstory": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "default": "./dist/plugin.mjs"
    },
    "./boot": {
      "types": "./dist/boot.d.ts",
      "default": "./dist/boot.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./foldkit": {
      "types": "./dist/foldkit.d.ts",
      "default": "./dist/foldkit.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "default": "./dist/solid.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "default": "./dist/svelte.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "default": "./dist/test.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "default": "./dist/mcp.mjs"
    },
    "./cli": {
      "types": "./dist/cli.d.mts",
      "default": "./dist/cli.mjs"
    },
    "./shell/*": "./dist/shell/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:shell && vp pack && pnpm run build:test-dts",
    "build:shell": "node ./scripts/build-shell.mjs",
    "build:test-dts": "node ./scripts/build-test-dts.mjs",
    "clean": "rm -rf dist",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:integration": "vp test --project integration",
    "typecheck": "tsc --noEmit",
    "check:errors": "node ./scripts/check-errors.mjs"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "fast-glob": "^3.3.2",
    "oxc-parser": "^0.108.0"
  },
  "devDependencies": {
    "@effect/platform-browser": "4.0.0-beta.88",
    "@pierre/trees": "1.0.0-beta.4",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.0.0-beta.88",
    "foldkit": "^0.127.0",
    "lucide-react": "^1.16.0",
    "playwright": "^1.60.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "solid-js": "^1.9.0",
    "svelte": "^5.55.9",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.0.0",
    "ts-dedent": "^2.2.0",
    "tw-animate-css": "^1.4.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^3.0.0",
    "vue": "^3.5.34"
  },
  "peerDependencies": {
    "@effect/platform-browser": ">=4.0.0-beta.66",
    "effect": ">=4.0.0-beta.66",
    "foldkit": ">=0.104.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "solid-js": "^1.5.0",
    "svelte": "^5.0.0",
    "typescript": ">=5.0.0",
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@effect/platform-browser": {
      "optional": true
    },
    "effect": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "foldkit": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  }
}
